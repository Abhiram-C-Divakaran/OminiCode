# WyrmSentry IDE - Environment Configuration Example

# 1. Gemini API Key (Required for AI code reviews & chat assistance)
# Retrieve your key from Google AI Studio. Keep this strictly server-side!
GEMINI_API_KEY=your_gemini_api_key_here

# 2. JWT Signing Secret (Required for real session encryption and validation)
# Change this to a strong, random key in production environments.
JWT_SECRET=your_secure_jwt_signing_secret_here

# 3. Environment identifier (dev, production)
NODE_ENV=development

# 4. Google OAuth Credentials (Required for real Google single sign-on)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 5. GitHub OAuth Credentials (Required for real GitHub single sign-on)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=


# Groq API key used by the server
GROQ_API_KEY=your_groq_api_key_here
