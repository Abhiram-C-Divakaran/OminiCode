# OminiCode environment configuration
# Copy to .env. Blank AI/cloud credentials do not prevent the local UI from starting.
# Never prefix a secret with VITE_: Vite exposes those values to browsers.

# Server
PORT=3000
# Optional public origin for the existing GitHub callback URL (no trailing slash).
APP_URL=http://localhost:3000
# npm start sets production automatically. npm run dev defaults to development.
NODE_ENV=development
# Existing Vite switch: true disables HMR/file watching in constrained environments.
DISABLE_HMR=false

# AI — server only. Optional until a user requests an AI review or chat response.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# GitHub OAuth — optional prototype integration, not secure production auth.
# Callback: APP_URL + /api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Firebase Admin — optional, only for Firestore-backed demonstration APIs.
# Application Default Credentials (ADC) may be used instead of a key file.
# Set this to an absolute path OUTSIDE the repository; never commit the JSON key.
GOOGLE_APPLICATION_CREDENTIALS=
GCLOUD_PROJECT=
# Admin originally used the default database. Set this to the client database ID
# from firebase-applet-config.json when intentionally targeting the same database.
FIRESTORE_DATABASE_ID=(default)
# Optional Admin SDK emulator endpoint, host:port (without http://).
FIRESTORE_EMULATOR_HOST=

# Explicit seed-write opt-in. Must equal projectId in firebase-applet-config.json.
# Leave blank during normal development. Seed scripts are never run automatically.
OMINICODE_SEED_PROJECT=

# Public Firebase web identifiers remain in firebase-applet-config.json.
# They identify a project; they are not Admin credentials and grant no permissions.
# No Google OAuth, JWT signing, payment, or deployment secrets are used in Phase 1.
